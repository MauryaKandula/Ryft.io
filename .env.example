# ==============================================================================
# RYFT.io (Internal Project ID: orb_arena_project) — Environment Configuration
# Copy this file to .env for local or production deployment. Never commit .env!
# ==============================================================================

# 1. Runtime & Project Identity
NODE_ENV=production
PORT=3000
PROJECT_ID=orb_arena_project
VITE_GAME_NAME=RYFT.io
VITE_GAME_DOMAIN=https://game.example.com
VITE_SUPPORT_EMAIL=support@game.example.com

# 2. Public Application URL (Used for OAuth 2.0 Redirect URI generation)
# Example (AI Studio Dev): https://ais-dev-vs7wamwosirvot7kqsbio7-348257724109.asia-northeast1.run.app
# Example (Production Custom Domain): https://game.example.com
APP_URL=https://game.example.com

# 3. Google OAuth 2.0 Credentials (Optional — Guest & Callsign login work without these)
# Authorized Redirect URIs to register in Google Cloud Console:
# - https://ais-dev-vs7wamwosirvot7kqsbio7-348257724109.asia-northeast1.run.app/auth/google/callback
# - https://ais-pre-vs7wamwosirvot7kqsbio7-348257724109.asia-northeast1.run.app/auth/google/callback
# - https://game.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Facebook OAuth 2.0 Credentials (Optional)
# Valid OAuth Redirect URIs to register in Meta for Developers Console:
# - https://ais-dev-vs7wamwosirvot7kqsbio7-348257724109.asia-northeast1.run.app/auth/facebook/callback
# - https://ais-pre-vs7wamwosirvot7kqsbio7-348257724109.asia-northeast1.run.app/auth/facebook/callback
# - https://game.example.com/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# 5. Admin & Revenue Telemetry Protection (Optional)
# When set, /api/admin/metrics and /api/admin/refund require header X-Admin-Token: <ADMIN_TOKEN>
ADMIN_TOKEN=

# 6. Optional External Payment & Ad SDK Configuration
# Do NOT populate with fake IDs. Leave blank until real merchant/publisher accounts are approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AD_PROVIDER_ENABLED=false
